{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"],
    "baseUrl": "../..",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "../../src/lib/bonus-engine/handlers/production-meter.ts",
    "../../src/lib/bonus-engine/schema.ts",
    "../../src/lib/bonus-engine/engine.ts",
    "../../src/types/bonus.ts",
    "../../scripts/create-chile-chico-rules.ts",
    "../../scripts/verify-fx-cc-rules.ts",
    "../../scripts/verify-cc-rerun.ts",
    "../../scripts/diag-cc-calc.ts"
  ]
}
